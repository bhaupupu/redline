# Hugging Face Token for Inference API (Optional, fallbacks provided)
HF_TOKEN=your_huggingface_token_here
HUGGINGFACE_HUB_TOKEN=your_huggingface_token_here

# Server Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*

# Hugging Face Models
HF_STT_MODEL=openai/whisper-large-v3
HF_EMOTION_MODEL=bhadresh-ps/wav2vec2-lg-xlsr-en-speech-emotion-recognition
HF_LLM_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
